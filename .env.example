# Absolute host home to expose to the manager's file explorer.
HOST_HOME_PATH=/home/vm
# Existing Minecraft service directory, located below HOST_HOME_PATH.
MINECRAFT_HOST_PATH=/home/vm/minecraft
MANAGER_DATA_PATH=/srv/mcserver-manager/data

# Numeric UID/GID of the Minecraft systemd service user.
MC_UID=1000
MC_GID=1000

MC_SERVICE_NAME=minecraft.service
# For a user-scoped systemd service on Linux Mint:
MC_CONTROL_HOST_PATH=/run/user/1000/mcmanager
RCON_HOST=host.docker.internal
RCON_PORT=25575
RCON_PASSWORD=replace-with-the-rcon-password
MASTER_PASSWORD=replace-with-a-long-panel-password
JWT_SECRET=replace-with-a-persistent-random-secret
