[Unit]
Description=Restricted Minecraft manager systemd bridge
After=local-fs.target

[Service]
Type=simple
User=root
Group=root
UMask=0007
Environment=MC_SERVICE_NAME=minecraft.service
Environment=MC_CONTROL_SOCKET=/run/mcmanager/control.sock
Environment=MC_SOCKET_GROUP=vm
ExecStartPre=/bin/mkdir -p /run/mcmanager
ExecStartPre=/bin/chown root:vm /run/mcmanager
ExecStartPre=/bin/chmod 0770 /run/mcmanager
ExecStart=/usr/local/libexec/mc-manager-bridge.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
