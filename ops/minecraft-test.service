[Unit]
Description=Temporary Minecraft server used by the MCServer Manager integration test

[Service]
Type=simple
WorkingDirectory=/home/vm/Projects/mcserver-manager/test/server
ExecStart=/home/vm/Projects/mcserver-manager/test/scripts/start.sh nogui
KillMode=control-group
KillSignal=SIGINT
SuccessExitStatus=130 SIGINT
TimeoutStopSec=30s
Restart=no
StandardOutput=append:/home/vm/Projects/mcserver-manager/test/server/logs/systemd-test.out
StandardError=append:/home/vm/Projects/mcserver-manager/test/server/logs/systemd-test.err
